{
  "version": 2,
  "redirects": [
    { "source": "/", "destination": "/lobby.html", "permanent": false }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/lobby.html", "destination": "/frontend/lobby.html" },
    { "source": "/index.html", "destination": "/frontend/index.html" },
    { "source": "/lobby.css", "destination": "/frontend/lobby.css" },
    { "source": "/lobby.js", "destination": "/frontend/lobby.js" },
    { "source": "/api.js", "destination": "/frontend/api.js" },
    { "source": "/game.js", "destination": "/frontend/game.js" },
    { "source": "/custom-rules.js", "destination": "/frontend/custom-rules.js" }
  ]
}
